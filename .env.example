OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=xpolllocal12345
NEO4J_DATABASE=neo4j

QDRANT_URL=https://your-qdrant-cluster.example.com
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_REGISTRY_COLLECTION=semantic_registry_v2
QDRANT_PROGRESS_COLLECTION=import_progress
QDRANT_MATCH_SCORE_THRESHOLD=0.92

DATASET_MODE=main
VOTES_JSON_PATH=./db/decompose
PROCESS_TILL_FIRST_N_VOTES=null
